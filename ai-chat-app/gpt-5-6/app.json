{
  "expo": {
    "name": "Nova",
    "slug": "nova-gpt-5-6",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/nova-icon.png",
    "scheme": "nova",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/nova-icon.png",
      "bundleIdentifier": "com.rami.nova.gpt56"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#16181B",
        "foregroundImage": "./assets/images/nova-adaptive-foreground.png",
        "monochromeImage": "./assets/images/nova-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "dark": {
            "backgroundColor": "#000000",
            "image": "./assets/images/nova-splash-dark.png"
          },
          "image": "./assets/images/nova-splash-light.png",
          "imageWidth": 76
        }
      ],
      "expo-widgets",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
